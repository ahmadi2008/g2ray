{
  "name": "g2ray",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "XRAY_VERSION": "v26.10.21"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },
  "remoteUser": "codespace",
  "postStartCommand": "/opt/g2ray/post-start.sh",
  "postAttachCommand": "/opt/g2ray/post-attach.sh",
  "forwardPorts": [443],
  "portsAttributes": {
    "443": {
      "label": "g2ray",
      "onAutoForward": "silent"
    }
  },
  "hostRequirements": {
    "cpus": 2
  }
}
